<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top App Bar / Brand Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="32sp"
            android:textStyle="bold|italic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <!-- Subheader Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tab_create"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/tab_create_listing"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="13sp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tab_my_listings"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/tab_my_listings"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1.2dp" />
            </LinearLayout>

            <!-- Main Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Image Upload Preview Area -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:id="@+id/iv_listing_cover"
                            android:contentDescription="@string/listing_cover_description"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/colorSurfaceContainerHigh"
                            android:scaleType="centerCrop"
                            tools:srcCompat="@tools:sample/backgrounds/scenic" />

                        <ImageView
                            android:id="@+id/iv_camera_badge"
                            android:contentDescription="@string/add_photo"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_circle_translucent"
                            android:padding="12dp"
                            android:src="@drawable/camera"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_photo_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_circle_translucent"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/photo_count_add"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/hint_title"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_description"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:gravity="top|start"
                        android:hint="@string/hint_description"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <!-- Optional Afrikaans / isiZulu versions of the title and description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/translations_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/translations_hint"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_title_af"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/translation_af_title"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_description_af"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/translation_af_description"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2000"
                        android:minHeight="48dp"
                        android:gravity="top|start"
                        android:minLines="2"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_title_zu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/translation_zu_title"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_description_zu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/translation_zu_description"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2000"
                        android:minHeight="48dp"
                        android:gravity="top|start"
                        android:minLines="2"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp" />

                    <!-- Listing Type (Scheduled / Ongoing) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_listing_type"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_listing_type"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:paddingHorizontal="14dp" />

                    <!-- Cause Categories (Comma-separated) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_cause_category"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_category"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:paddingHorizontal="14dp" />

                    <!-- Area -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_area"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/hint_area"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <!-- Skills Required -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_skills_required"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_skills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="@string/hint_skills_pick"
                        android:inputType="none"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <!-- Conditional Scheduled Container (Date/Time & Spaces) -->
                    <LinearLayout
                        android:id="@+id/layout_scheduled_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/label_date_time"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_rounded_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <TextView
                                android:id="@+id/tv_date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/hint_select_date"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="46dp"
                                android:gravity="center_vertical"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_select_time"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="46dp"
                                android:gravity="center_vertical"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/label_spaces"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_spaces"
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_rounded_input"
                            android:gravity="center_vertical"
                            android:hint="@string/hint_spaces"
                            android:inputType="number"
                            android:paddingHorizontal="14dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Minimum Hours -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/label_min_hours"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_hours"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_rounded_input"
                        android:gravity="center_vertical"
                        android:hint="@string/hint_hours_example"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="14dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_discard"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="110dp"
                            android:minHeight="48dp"
                            android:layout_marginEnd="16dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/discard"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="1.2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="110dp"
                            android:minHeight="48dp"
                            android:elevation="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/save"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="14sp"
                            app:backgroundTint="?attr/colorPrimary"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>