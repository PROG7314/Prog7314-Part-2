<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Top App Bar / Brand Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#838E50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Aegis"
            android:textColor="#F9F6EB"
            android:textSize="32sp"
            android:textStyle="bold|italic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <!-- Subheader Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tab_create"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="+ Create Listing"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:backgroundTint="#838E50"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tab_my_listings"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="My Listings"
                    android:textAllCaps="false"
                    android:textColor="#838E50"
                    android:textSize="13sp"
                    app:cornerRadius="19dp"
                    app:strokeColor="#838E50"
                    app:strokeWidth="1.2dp" />
            </LinearLayout>

            <!-- Main Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Image Upload Preview Area -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:id="@+id/iv_listing_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#E8E8E8"
                            android:scaleType="centerCrop"
                            tools:srcCompat="@tools:sample/backgrounds/scenic" />

                        <ImageView
                            android:id="@+id/iv_camera_badge"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_circle_translucent"
                            android:padding="6dp"
                            android:src="@drawable/camera"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:tint="#6E7745" />

                        <TextView
                            android:id="@+id/tv_photo_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_circle_translucent"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Add up to 3 photos"
                            android:textColor="#6E7745"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Title *"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="Enter listing title"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="#212121"
                        android:textSize="14sp" />

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Description *"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:gravity="top|start"
                        android:hint="Describe the activity..."
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="#212121"
                        android:textSize="14sp" />

                    <!-- Listing Type (Scheduled / Ongoing) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Listing Type *"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_listing_type"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:paddingHorizontal="14dp" />

                    <!-- Cause Categories (Comma-separated) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Cause Category *"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_category"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:paddingHorizontal="14dp" />

                    <!-- Area -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Area / Suburb *"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="e.g. Wynberg, Cape Town"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="#212121"
                        android:textSize="14sp" />

                    <!-- Skills Required -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Skills Required"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_skills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="Tap to choose skills"
                        android:inputType="none"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="#212121"
                        android:textSize="14sp" />

                    <!-- Conditional Scheduled Container (Date/Time & Spaces) -->
                    <LinearLayout
                        android:id="@+id/layout_scheduled_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Date &amp; Time *"
                            android:textColor="#212121"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_rounded_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <TextView
                                android:id="@+id/tv_date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Select Date"
                                android:minHeight="46dp"
                                android:gravity="center_vertical"
                                android:textColor="#212121"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:hint="Select Time"
                                android:minHeight="46dp"
                                android:gravity="center_vertical"
                                android:textColor="#212121"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Spaces Available *"
                            android:textColor="#212121"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_spaces"
                            android:layout_width="120dp"
                            android:layout_height="44dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_rounded_input"
                            android:gravity="center_vertical"
                            android:hint="e.g. 10"
                            android:inputType="number"
                            android:paddingHorizontal="14dp"
                            android:textColor="#212121"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Minimum Hours -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Minimum Hours *"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_hours"
                        android:layout_width="120dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_rounded_input"
                        android:gravity="center_vertical"
                        android:hint="e.g. 2"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="14dp"
                        android:textColor="#212121"
                        android:textSize="14sp" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_discard"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="110dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="16dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Discard"
                            android:textAllCaps="false"
                            android:textColor="#838E50"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#838E50"
                            app:strokeWidth="1.2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save"
                            android:layout_width="110dp"
                            android:layout_height="44dp"
                            android:elevation="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Save"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            app:backgroundTint="#838E50"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>