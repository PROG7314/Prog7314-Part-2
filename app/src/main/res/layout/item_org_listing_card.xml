<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/aegis_card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/listingImage"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="@color/aegis_green"
            android:contentDescription="@string/listing_image_description"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_pill"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="UPCOMING"
            app:layout_constraintTop_toTopOf="@id/listingImage"
            app:layout_constraintStart_toStartOf="@id/listingImage" />

        <TextView
            android:id="@+id/listingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/aegis_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Read to Kids at Christine Revell Children's Home"
            app:layout_constraintTop_toBottomOf="@id/listingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/signupCountNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/aegis_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="15"
            app:layout_constraintTop_toBottomOf="@id/listingTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/signupCountLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:text="@string/people_signed_up_for_this_event"
            android:textColor="@color/aegis_text_secondary"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/signupCountNumber"
            app:layout_constraintBottom_toBottomOf="@id/signupCountNumber"
            app:layout_constraintStart_toEndOf="@id/signupCountNumber"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/viewDetailsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/view_details"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_primary"
            app:layout_constraintTop_toBottomOf="@id/signupCountNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>