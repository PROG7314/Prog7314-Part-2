<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/orgListingDetailFragment"
        android:name="com.example.aegis.ui.listing.OrgListingDetailFragment"
        android:label="OrgListingDetailFragment" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.aegis.ui.auth.SplashFragment"
        android:label="Splash">

        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />


        <action
            android:id="@+id/action_splashFragment_to_roleSelectionFragment"
            app:destination="@id/roleSelectionFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashFragment_to_orgHomeFragment"
            app:destination="@id/orgHomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.aegis.ui.auth.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_orgHomeFragment"
            app:destination="@id/orgHomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_roleSelectionFragment"
            app:destination="@id/roleSelectionFragment" />

    </fragment>

    <fragment
        android:id="@+id/roleSelectionFragment"
        android:name="com.example.aegis.ui.roleselection.RoleSelectionFragment"
        android:label="Role Selection">

        <action
            android:id="@+id/action_roleSelectionFragment_to_interestMatchingFragment"
            app:destination="@id/interestMatchingFragment" />

        <action
            android:id="@+id/action_roleSelectionFragment_to_orgHomeFragment"
            app:destination="@id/orgHomeFragment"
            app:popUpTo="@id/roleSelectionFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/orgSignupsFragment"
        android:name="com.example.aegis.ui.main.OrgSignupsFragment"
        android:label="Sign-ups" />

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.aegis.ui.main.VolunteerHomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/commitmentsFragment"
        android:name="com.example.aegis.ui.commitments.CommitmentsFragment"
        android:label="My Commitments" />

    <fragment
        android:id="@+id/hoursFragment"
        android:name="com.example.aegis.ui.hours.HoursFragment"
        android:label="My Hours" />

    <fragment
        android:id="@+id/orgHomeFragment"
        android:name="com.example.aegis.ui.main.OrgHomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_orgHomeFragment_to_createListingFragment"
            app:destination="@id/createListingFragment" />

        <action
            android:id="@+id/action_orgHomeFragment_to_orgSignupsFragment"
            app:destination="@id/orgSignupsFragment" />

    </fragment>

    <fragment
        android:id="@+id/createListingFragment"
        android:name="com.example.aegis.ui.listing.CreateListingFragment"
        android:label="Create Listing" />

    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.example.aegis.ui.messages.MessagesFragment"
        android:label="Messages" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.aegis.ui.messages.ChatFragment"
        android:label="Chat" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.aegis.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.aegis.ui.profile.ProfileFragment"
        android:label="Profile">

        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/interestMatchingFragment"
        android:name="com.example.aegis.ui.custom.InterestMatchingFragment"
        android:label="Interests">

        <action
            android:id="@+id/action_interestMatchingFragment_to_skillsFragment"
            app:destination="@id/skillsFragment" />

    </fragment>

    <fragment
        android:id="@+id/skillsFragment"
        android:name="com.example.aegis.ui.custom.SkillsFragment"
        android:label="Skills">

        <action
            android:id="@+id/action_skillsFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <!-- Global: reachable from any destination, e.g. a settings icon on the eventual home screen -->
    <action
        android:id="@+id/action_global_settingsFragment"
        app:destination="@id/settingsFragment" />

</navigation>