# Copy this file to .env for local use. On Render, set these in the dashboard instead. NEVER commit .env.
PORT=3000

# At least 32 characters. Generate one with:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# true = interests/skills/causes must come from the fixed lists in src/constants.js
ENFORCE_FIXED_LISTS=true

# The ENTIRE Firebase service-account JSON on one line (or the base64 of that JSON).
FIREBASE_SERVICE_ACCOUNT=