# Copy this file to keystore.properties (it is git-ignored) and fill in your own values.
# Keep the keystore file itself OUT of the repository and back it up: if it is lost, an app already on the
# Play Store can never be updated.
storeFile=/absolute/path/to/aegis-release.jks
storePassword=change-me
keyAlias=aegis
keyPassword=change-me
